{
  "name": "codex-remote-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "node dist-server/index.js",
    "inspect": "node scripts/inspect.mjs",
    "setup": "node scripts/setup.mjs",
    "service": "node scripts/service.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "test:browser": "npm run build && node tests/browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ajv": "^8.20.0",
    "dompurify": "^3.2.7",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
